#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <100>;
            key-positions = <6 8>;  /* bottom-left + bottom-right */
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp N9  &kp N8  &kp N7
                &kp N6  &kp N5  &kp N4
                &kp N3  &kp N2  &kp N1
            >;
        };
    };
};
